{
  "$schema": "https://app.kilo.ai/config.json",
  "agent": {
    "1c-analytic": {
      "description": "Expert 1C business analyst agent. Analyzes existing code and metadata structure, writes PRD (Product Requirements Document), specifications, and answers architectural questions.",
      "mode": "subagent",
      "model": "anthropic/claude-3-opus-20240229",
      "temperature": 0.3,
      "steps": 25,
      "color": "#4F46E5",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "1c-metadata-manager": "allow",
          "1c-developer": "allow",
          "general": "allow",
          "explore": "allow"
        }
      }
    },
    "1c-code-reviewer": {
      "description": "Reviews 1C code for best practices, performance issues, and security vulnerabilities",
      "mode": "subagent",
      "model": "anthropic/claude-3-opus-20240229",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "general": "allow",
          "explore": "allow"
        }
      }
    },
    "1c-architect": {
      "description": "Designs 1C metadata architecture and integration solutions",
      "mode": "subagent",
      "model": "anthropic/claude-3-opus-20240229",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "1c-metadata-manager": "allow",
          "general": "allow",
          "explore": "allow"
        }
      }
    }
  }
}
